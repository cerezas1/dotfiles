{
    "layer": "top",
    "position": "right",
    "width": 54,
    "spacing": 0,
    "margin-top": 4,
    "margin-bottom": 4,
    "reload_style_on_change": true,
    
    "modules-left": [
      "group/clock-group",
      "group/utils-group"
    ],

    "modules-right": [
        "hyprland/workspaces",
        "group/status-group",
        "group/sys-group",
        "group/logo-group"
    ],

    "group/clock-group": {
        "orientation": "inherit",
        "modules": ["clock"]
    },
    "group/utils-group": {
        "orientation": "inherit",
        "modules": ["pulseaudio", "custom/wallpaper-selector", "custom/matugen-selector"]
    },
    "group/workspaces-group": {
        "orientation": "inherit",
        "modules": ["hyprland/workspaces"]
    },
    "group/status-group": {
        "orientation": "inherit",
        "modules": ["network", "custom/hyprsunset", "backlight"]
    },
    "group/sys-group": {
        "orientation": "inherit",
        "modules": ["memory", "cpu"]
    },
    "group/logo-group": {
        "orientation": "inherit",
        "modules": ["custom/distro-logo"]
    },

    "clock": {
        "format": "{0:%H}\n{0:%M}",
        "tooltip-format": "{:%A, %d de %B de %Y}"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "⚊",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "custom/wallpaper-selector": {
        "format": "䷊",
        "on-click": "~/.config/rofi/menus/wallpaperselect.sh",
        "tooltip": false
    },

    "custom/matugen-selector": {
        "format": "䷢",
        "on-click": "~/.config/rofi/scripts/color-picker-rofi.sh",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons":{
        "1": "Π",
        "2": "Ψ",
        "3": "Ρ",
        "4": "Σ",
        "5": "Τ",
        "6": "Θ",
        "7": "Υ",
        "8": "Ξ",
        "9": "Ζ"
        }
    },


    "network": {
        "interface": "wlan0",
        "format-wifi": "{icon}",
        "format-icons": ["¼", "⅓", "½", "⅔", "1"],
        "tooltip-format": "SSID: {essid} {signalStrength}%"
    },


    "backlight": {
        "format": "{icon} {percent}",
        "format-icons": ["☶", "☳", "☵"],
        "on-scroll-up": "brightnessctl s +5%",
        "on-scroll-down": "brightnessctl s 5%-",
        "tooltip": true,
        "tooltip-format": "Brillo: {percent}%"
    },

    "memory": {
        "format": "♚ {}%",
        "interval": 2,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB"
    },

    "cpu": {
        "format": "♛ {usage}%",
        "interval": 2
    },

    "custom/distro-logo": {
        "format": "",
        "tooltip": false
    },
    "custom/hyprsunset": {
      "exec": "~/.config/waybar/scripts/hyprsunset-status.sh",
      "on-click": "~/.config/waybar/scripts/hyprsunset-toggle.sh",
      "signal": 8,
      "return-type": "json"
    }
}
