;; ==== Selector de color de matugen ====
;;
;; wallpaper_swatches lo llena refresh-and-open-colorpicker.sh via
;; "eww update" justo antes de abrir esta ventana (no es un defpoll,
;; porque no tiene sentido recalcular la paleta todo el tiempo si el
;; wallpaper no cambio).
(defvar wallpaper_swatches "[]")

(defwindow color_picker_popup
   :monitor 0
   :geometry (geometry :x "0px" :y "40px" :width "300px" :height "140px" :anchor "top center")
   :stacking "fg"
   :windowtype "normal"
   :wm-ignore true
   (color_picker))

(defwidget color_picker []
  (box :class "color-picker-box" :orientation "v" :space-evenly false

    (label :class "picker-title" :text "Elegi un color base")

    (box :class "swatch-row" :orientation "h" :halign "center" :space-evenly true
      (for c in wallpaper_swatches
        (button :class "swatch-btn"
                :style "background-color: ${c};"
                :onclick "matugen color hex '${c}' && eww close color_picker_popup"
                :tooltip "${c}"
                "")
      )
    )
  )
)
