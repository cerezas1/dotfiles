;; ==== Calendario ====

;; month_offset: cuantos meses de diferencia respecto al mes actual estamos
;; mostrando (0 = mes actual, 1 = siguiente, -1 = anterior, etc.)
(defvar month_offset 0)

;; dia que el usuario clickeo en el grid (lo setea calender.c via
;; "eww update selected_day=N" en cada boton)
(defvar selected_day 0)

;; NOTA: el comando de un defpoll no puede interpolar otras variables
;; con ${...} (eso solo funciona dentro de atributos de widgets). Por
;; eso leemos month_offset llamando al CLI de eww desde el shell con
;; `eww get`, que es una llamada de shell comun, no interpolacion yuck.
(defpoll calendar_content
  :interval "1s"
  :initial "(box)"
  "~/.config/eww/scripts/calender $(eww get month_offset)")

(defwindow calendar_popup
   :monitor 0
   :geometry (geometry :x "0px" :y "40px" :width "340px" :height "360px" :anchor "top center")
   :stacking "fg"
   :windowtype "normal"
   :wm-ignore true
   (calendario))

(defwidget calendario []
  (box :class "calendar-box" :orientation "v" :space-evenly false

    (box :class "calendar-nav" :orientation "h" :space-evenly false
      (button :class "nav-btn" :onclick "eww update month_offset=$(( ${month_offset} - 1 ))" "‹")
      (box :hexpand true)
      (button :class "nav-btn today-btn" :onclick "eww update month_offset=0" "hoy")
      (box :hexpand true)
      (button :class "nav-btn" :onclick "eww update month_offset=$(( ${month_offset} + 1 ))" "›")
    )

    (box :class "gap-md")

    (literal :content calendar_content)

    (box :class "gap-sm")

    (label :class "selected-day-label"
           :visible {selected_day != 0}
           :text "Dia seleccionado: ${selected_day}")
  )
)
